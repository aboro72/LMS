SECRET_KEY=dein-geheimer-key-mindestens-50-zeichen-lang
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# -----------------------------------------------------------------------
# Datenbankmotor: postgresql | mysql | mssql | mongodb
# -----------------------------------------------------------------------
DB_ENGINE=postgresql

# PostgreSQL (Standard)
DATABASE_URL=postgres://aborolms:passwort@localhost:5432/aborolms

# MySQL / MariaDB
# DATABASE_URL=mysql://aborolms:passwort@localhost:3306/aborolms

# Microsoft SQL Server (mssql-django muss installiert sein)
# DB_ENGINE=mssql
# DB_NAME=aborolms
# DB_USER=aborolms
# DB_PASSWORD=passwort
# DB_HOST=localhost
# DB_PORT=1433

# MongoDB (django-mongodb-backend muss installiert sein – experimentell)
# DB_ENGINE=mongodb
# DB_NAME=aborolms
# DB_HOST=localhost
# DB_PORT=27017
# DB_USER=
# DB_PASSWORD=

# -----------------------------------------------------------------------
# Medien und statische Dateien
# -----------------------------------------------------------------------
MEDIA_ROOT=media/
MEDIA_URL=/media/

# -----------------------------------------------------------------------
# E-Mail
# -----------------------------------------------------------------------
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@aborosoft.de

# -----------------------------------------------------------------------
# Zahlungen
# -----------------------------------------------------------------------
PLATFORM_COMMISSION_PERCENT=15
PAYMENT_DEMO_AUTOCONFIRM=True
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# -----------------------------------------------------------------------
# Sicherheit (nur Produktion)
# -----------------------------------------------------------------------
SECURE_SSL_REDIRECT=True

# -----------------------------------------------------------------------
# Optionaler S3-Medien-Storage
# -----------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=

# In ISPConfig3 als Custom-Nginx-Konfiguration der Website eintragen.
# Der Socket-Pfad muss zur Installation passen.

client_max_body_size 500M;

location /static/ {
    alias /opt/aborolms/staticfiles/;
    expires 30d;
    add_header Cache-Control "public, immutable";
}

location /media/ {
    alias /opt/aborolms/media/;
    expires 7d;
}

location / {
    proxy_pass http://unix:/run/aborolms/gunicorn.sock:;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_read_timeout 120s;
}
